# Environment Variables Example
# Copy this file to .env.development.local and fill in your values

# Server
PORT=5500
NODE_ENV=development
SERVER_URL=http://localhost:5500

# Database (MongoDB Atlas)
DB_URL=mongodb+srv://username:password@cluster.mongodb.net/subscription-tracker

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters
JWT_EXPIRES_IN=1d

# Arcjet (Rate Limiting & Bot Protection)
# Get your key at https://arcjet.com
ARCJET_KEY=ajkey_your_arcjet_key

# Upstash QStash (Workflow Automation)
# Get your credentials at https://upstash.com
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=your_qstash_token

# Email (Gmail SMTP)
# Generate App Password at https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_gmail_app_password
